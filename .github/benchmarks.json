{
  "sweep": {"minimum_prompts": 16, "waves": 2, "warmup_waves": 1},
  "budgets": {"kernel": 0.5, "forward": 3},
  "cycles_per_ms": 2000000,
  "tasks": {
    "text": {
      "serve": ["--dtype", "bfloat16", "--generation-config", "vllm"],
      "bench": [
        "--dataset-name", "random", "--temperature", "0", "--ignore-eos",
        "--percentile-metrics", "ttft,tpot,e2el"
      ],
      "serving": {
        "gate": [{"input": 128, "output": 128, "widths": [16]}],
        "nightly": [
          {"input": 1024, "output": 1024, "widths": [1, 2, 4, 8, 16, 32, 64]},
          {"input": 1024, "output": 8192, "widths": [16]},
          {"input": 8192, "output": 1024, "widths": [1, 4, 16]}
        ]
      }
    },
    "embedding": {
      "serve": [
        "--runner", "pooling", "--dtype", "bfloat16", "--hf-overrides",
        "{\"is_matryoshka\":true}"
      ],
      "bench": ["--backend", "openai-embeddings", "--endpoint", "/v1/embeddings", "--dataset-name", "random"],
      "serving": {"nightly": [{"input": 512, "widths": [1, 4, 16, 64]}]}
    },
    "reranking": {
      "serve": [
        "--runner", "pooling", "--dtype", "bfloat16", "--hf-overrides",
        "{\"architectures\":[\"Qwen3ForSequenceClassification\"],\"classifier_from_token\":[\"no\",\"yes\"],\"is_original_qwen3_reranker\":true}",
        "--chat-template", "{checkpoint}/chat_template.jinja"
      ],
      "bench": [
        "--backend", "vllm-rerank", "--endpoint", "/v1/rerank", "--dataset-name", "random-rerank",
        "--random-batch-size", "1"
      ],
      "serving": {"nightly": [{"input": 512, "widths": [1, 4, 16, 64]}]}
    },
    "classification": {
      "serve": ["--runner", "pooling", "--convert", "classify", "--dtype", "bfloat16"],
      "bench": [
        "--backend", "vllm-rerank", "--endpoint", "/v1/rerank", "--dataset-name", "random-rerank",
        "--random-batch-size", "1"
      ],
      "serving": {"nightly": [{"input": 512, "widths": [1, 4, 16, 64]}]}
    }
  },
  "models": [
    {
      "id": "Qwen/Qwen3-0.6B", "tier": "gate", "task": "text", "doc": "qwen3-0.6b",
      "forward": "qwen3_0_6b_forward"
    },
    {
      "id": "Qwen/Qwen3-1.7B", "tier": "gate", "task": "text", "doc": "qwen3-1.7b",
      "forward": "qwen3_1_7b_forward"
    },
    {
      "id": "Qwen/Qwen3-4B", "tier": "gate", "task": "text", "doc": "qwen3-4b",
      "forward": "qwen3_4b_forward"
    },
    {
      "id": "Qwen/Qwen3-4B-Instruct-2507", "tier": "nightly", "task": "text", "doc": "qwen3-4b",
      "serve": ["--max-model-len", "40960"], "measured_as": "Qwen/Qwen3-4B"
    },
    {
      "id": "Qwen/Qwen3-4B-Thinking-2507", "tier": "nightly", "task": "text", "doc": "qwen3-4b",
      "serve": ["--max-model-len", "40960"], "measured_as": "Qwen/Qwen3-4B"
    },
    {
      "id": "Qwen/Qwen3-8B", "tier": "gate", "task": "text", "doc": "qwen3-8b",
      "forward": "qwen3_8b_forward"
